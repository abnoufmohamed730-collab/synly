# Copy to .env.local (or set these in your deployment environment).
# The app throws at startup if the two VITE_SUPABASE_* variables are missing.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-anon-key>

# Optional map provider overrides (defaults to the public OpenStreetMap services).
# Point these at a licensed tile provider before production use.
# VITE_MAP_TILE_URL=https://tiles.example.com/{z}/{x}/{y}.png
# VITE_MAP_TILE_ATTRIBUTION=© Example Maps
# VITE_MAP_DIRECTIONS_URL=https://www.openstreetmap.org/directions
# VITE_MAP_VIEW_URL=https://www.openstreetmap.org/